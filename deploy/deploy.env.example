# ===== 喵迹云端部署环境变量 =====
# 复制本文件为 deploy/deploy.env 并填写真实值，再运行 bash deploy/deploy.sh
# deploy.sh 会读取同目录下的 deploy/deploy.env（不会被提交入库）

# 【必填】AI 密钥（仅存服务端，绝不下发前端）
DEEPSEEK_API_KEY=sk-你的DeepSeekKey
VISION_KEY=sk-你的DashScopeKey

# 【可选】模型（留默认即可）
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
VISION_MODEL=qwen3.7-plus
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 【可选】后端
JWT_SECRET=                      # 留空 → 脚本自动生成随机值
DB_PATH=./data/miaoji.db

# 【可选】站点域名：填了且已解析到本机公网 IP，脚本自动用 certbot 签 HTTPS 证书
# 不填则先用 IP + HTTP（注意：手机调用摄像头需 HTTPS，生产环境务必配域名）
SITE_DOMAIN=
