[Unit]
Description=喵迹云端后端 (Express + better-sqlite3)
After=network.target

[Service]
Type=simple
User=miaoji
WorkingDirectory=/opt/miaoji/server
ExecStart=/usr/bin/node /opt/miaoji/server/server.js
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
